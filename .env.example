# Polymarket — Magic/Google wallet (signature_type=1, POLY_PROXY)
# NEVER commit the real .env — only this example file is tracked

# Private key exported from your Magic wallet (Polymarket settings → export key)
POLY_PRIVATE_KEY=0xYOUR_MAGIC_WALLET_PRIVATE_KEY

# Proxy wallet address shown in your Polymarket profile (0x...)
POLY_FUNDER=0xYOUR_PROXY_WALLET_ADDRESS

# API key from Polymarket settings → API keys → Create
# Secret and passphrase are optional — derived from wallet automatically if left blank
POLY_API_KEY=YOUR_API_KEY
POLY_API_SECRET=
POLY_API_PASSPHRASE=

POLY_CHAIN_ID=137

# Telegram notifications (optional — leave blank to disable)
# Create a bot via @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram usernames allowed to receive notifications
TELEGRAM_ALLOWED_USERNAMES=

# Log level for file output (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
